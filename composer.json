{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/blank-livewire-starter-kit",
    "type": "project",
    "description": "The official Laravel starter kit for Livewire.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "arzcode/filament-magic-login": "dev-claude/user-login-link-expiry-qnt2qv",
        "bugsnag/bugsnag-laravel": "^2.30",
        "filament/filament": "^5.0",
        "laravel/ai": "^0.11.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "livewire/blaze": "^1.0",
        "livewire/livewire": "^4.1",
        "spatie/laravel-ray": "^1.43"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.7",
        "beyondcode/laravel-query-detector": "^2.3",
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.24",
        "filament/blueprint": "^2.2",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.5",
        "laravel/doctor": "^0.1.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.30",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "rector/rector": "^2.6",
        "shuvroroy/filament-spatie-laravel-backup": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "rector": [
            "rector process",
            "pint --dirty"
        ],
        "rector:check": [
            "rector process --dry-run"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@rector:check",
            "@types:check",
            "@test:full"
        ],
        "types:check": [
            "Composer\\Config::disableProcessTimeout",
            "phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "vendor/bin/pest --parallel --tia --compact"
        ],
        "test:full": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test --parallel --compact"
        ],
        "test:serial": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test --compact"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi",
            "@php artisan filament:upgrade",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "filament-magic-login",
            "type": "path",
            "url": "/Users/coder497/Code/arzcode/filament-magic-login"
        },
        {
            "name": "filament",
            "type": "composer",
            "url": "https://packages.filamentphp.com/composer"
        }
    ]
}
