APP_NAME="La Anónima"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://laanonima.test

# The panels are being shown off to anyone with the address, so nobody -- the
# administrator included -- may delete a record or withdraw a reader's request
# while this is on. Defaults to true when unset: forgetting it on the demo box
# costs the catalog, forgetting it here only costs the delete buttons.
DEMO_MODE=false


APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,bugsnag
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Error reporting
BUGSNAG_API_KEY=
BUGSNAG_NOTIFY_RELEASE_STAGES=production

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laanonima
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=3000
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=
SETTINGS_CACHE_ENABLED=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Where the "reserve it for me" and "order it for me" links on a book page write to.
SITE_CONTACT_EMAIL=hola@laanonimalibreria.com
# Where La Cupida's credit warnings go. Falls back to SITE_CONTACT_EMAIL when unset.
ADMIN_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Book metadata lookup. Open Library needs no key and is used by default.
# Google Books is skipped entirely until a key is set: its unauthenticated
# quota is shared and routinely exhausted, so keyless calls just return 429.
# Free key (no billing account needed): https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_COUNTRY=ES
BOOK_METADATA_USER_AGENT="LaAnonima/1.0 (+https://laanonimalibreria.arzcode.com)"

# La Cupida writes its book recommendation with Claude. With no key set the page
# still works: it recommends the best match from its own scoring and shows a
# canned line instead of a written one.
ANTHROPIC_API_KEY=

# La Cupida warns when what is left on the Anthropic account -- the balance
# entered in the panel, minus what the recommendations have cost since -- drops
# below this, in dollars.
CUPIDA_CREDIT_WARN_BELOW=1.00

# La Cupida — all four have working defaults in config/cupida.php.
# CUPIDA_MODEL=claude-haiku-4-5
# CUPIDA_SHOP_URL=https://laanonimalibreria.com
# CUPIDA_WIKIMEDIA_USER_AGENT=
# CUPIDA_USER_AGENT=

# Correos offline mode. There is no sandbox to sign up for, so with this on the
# SDK is answered from memory and no call leaves the machine -- enough to drive
# the panel's Correos page end to end. Ignored in production.
CORREOS_FAKE=false

# Correos. Two credential pairs, both required: the OAuth pair mints the token,
# the gateway pair is sent as headers on every call. The URLs below are the
# pre-production ones -- drop them to hit production. PRE only answers Monday to
# Friday, 08:00-20:00 CET, and only from an IP Correos has whitelisted.
CORREOS_OAUTH_CLIENT_ID=
CORREOS_OAUTH_CLIENT_SECRET=
CORREOS_GATEWAY_CLIENT_ID=
CORREOS_GATEWAY_CLIENT_SECRET=
CORREOS_TOKEN_URL=https://apioauthcid.correospre.es/Api/Authorize/Token
CORREOS_PREREGISTER_URL=https://api1.correospre.es/admissions/preregister/api/v1
CORREOS_LABELS_URL=https://api1.correospre.es/support/labels/api/v1
CORREOS_TRACKING_URL=https://api1.correospre.es/support/trackpub/api/v2

# The contract, and where the parcels leave from. Not read by the SDK: they fill
# in the panel's Correos page and whatever books shipments later.
CORREOS_CONTRACT_NUMBER=
CORREOS_CLIENT_NUMBER=
CORREOS_LABELLER_CODE=
CORREOS_SENDER_ADDRESS=
CORREOS_SENDER_LOCALITY=
CORREOS_SENDER_PROVINCE=
CORREOS_SENDER_CP=

# Someone is watching a spinner, so a call must not sit for the 30s a worker
# would wait.
CORREOS_TIMEOUT=8
CORREOS_CONNECT_TIMEOUT=3
